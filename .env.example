# ======================================================
# AI Learning Assistant - 环境变量示例
# 复制为 .env 后填写真实值：cp .env.example .env
# 切勿将 .env 提交到 Git
# ======================================================

# ---------- AI Provider 通用 ----------
# 可选值：openai_compatible（默认，兼容 DeepSeek/MiMo/OpenAI/硅基流动等）
#         fake（无需 API Key，用于测试与演示，回答为模板内容）
AI_PROVIDER=openai_compatible

# 聊天模型（OpenAI 兼容 /chat/completions 端点）
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=sk-xxxxxxxxxxxxxxxx
AI_CHAT_MODEL=deepseek-chat

# ---------- Embedding 服务（独立可配）----------
# 注意：DeepSeek 官方 API 不提供 embedding 端点，
# 请使用支持 OpenAI 兼容 embedding 的服务，例如硅基流动的 BAAI/bge-m3
# 留空则复用上面的 AI_BASE_URL / AI_API_KEY
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# ---------- 存储 ----------
DATABASE_PATH=backend/data/app.db
CHROMA_PATH=backend/data/chroma
UPLOAD_DIR=backend/data/uploads

# ---------- 检索与分块（一般无需修改）----------
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=6

# ---------- 服务 ----------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
